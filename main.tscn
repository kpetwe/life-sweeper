text = "ABOUT"
horizontal_alignment = 1

[node name="RichTextLabel2" type="RichTextLabel" parent="OptionsMenuGUI/OptionsMenu/VBoxContainer/HBoxContainer/RightVboxContainer/about/VBoxContainer" unique_id=1757542527]
custom_minimum_size = Vector2(16, 254)
layout_mode = 2
offset_transform_enabled = true
offset_transform_position = Vector2(4, 0)
offset_transform_visual_only = false
mouse_filter = 1
theme_override_colors/default_color = Color(0.14901961, 0.13725491, 0.12156863, 1)
theme_override_font_sizes/normal_font_size = 8
text = "Published in 1970, John Conway's Game of Life is a cellular automaton model simulated by the following rules: Consider an infinite 2x2 grid (or in our case, a finite, wrapping grid) that contains a random population of \"living cells.\"

	(1) If a living cell has less than 2 living neighbors (ie. of the 8
	cells surrounding it), then it \"dies\" due to isolation.

	(2) If a living cell has more than 4 living neighbors, then it 
	\"dies\" due to overpopulation.

	(3) If an empty cell has exactly 3 living neighbors, then it 
	becomes \"alive\" due to reproduction.

This minesweeper game allows for the player to bring the mines to life using Conway's or a similar Life-like model. With each tile dug, the next generation of mines are created. Note that the \"neighbors\" listed by the safe tiles do not account for the wrapping of the grid.

Thank you for playing."

