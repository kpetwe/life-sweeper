[node name="RichTextLabel" type="RichTextLabel" parent="OptionsMenuGUI/OptionsMenu/VBoxContainer/HBoxContainer/RightVboxContainer/about/VBoxContainer" unique_id=1244638734]
custom_minimum_size = Vector2(16, 30)
